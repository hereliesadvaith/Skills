# Directus connection settings — fill these in. Never commit this file (.env is gitignored).

# Base URL of your Directus instance, no trailing slash.
DIRECTUS_URL=https://cms.your-domain.com

# Preferred: a user's static token (Data Studio > User Directory > user > Token,
# or PATCH /users/<id> {"token": "..."}). Never expires; shown only once.
DIRECTUS_TOKEN=

# Fallback if DIRECTUS_TOKEN is empty: log in with email + password (/auth/login).
DIRECTUS_EMAIL=
DIRECTUS_PASSWORD=

# Optional: request timeout in seconds.
DIRECTUS_TIMEOUT=30

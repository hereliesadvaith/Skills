# n8n connection settings — fill these in. Never commit this file (.env is gitignored).

# Base URL of your n8n instance, no trailing slash (the URL you open in the browser).
# The script appends /api/v1 itself.
N8N_URL=https://n8n.your-domain.com

# API key: n8n UI > Settings > n8n API > Create an API key. Shown only once.
# Sent as the X-N8N-API-KEY header.
N8N_API_KEY=

# Optional: request timeout in seconds.
N8N_TIMEOUT=30
